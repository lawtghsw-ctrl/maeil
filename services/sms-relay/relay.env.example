# systemd EnvironmentFile format. Keep the real file outside the source tree.
# This blank example intentionally cannot start the service.
RELAY_BEARER_TOKEN=
ALIGO_CREDENTIAL_SOURCE=server-env
# Required only for server-env; keep blank for request mode.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_ALLOWLIST=
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_MAX_CONCURRENCY=2
# Live delivery is a separate, explicitly authorized feature. Disabled by default.
RELAY_LIVE_ENABLED=false
RELAY_LIVE_BEARER_TOKEN=
RELAY_LIVE_APPROVAL_EPOCH=
RELAY_STATE_DB_PATH=/var/lib/lawpower-sms-relay/dispatch.sqlite
# Start with only explicitly approved test recipients. Empty fails closed.
RELAY_LIVE_RECEIVER_ALLOWLIST=
RELAY_LIVE_ALLOW_ALL_RECEIVERS=false
