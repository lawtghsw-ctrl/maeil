# systemd EnvironmentFile format. Keep the real file outside the source tree.
# This blank example intentionally cannot start the service.
RELAY_BEARER_TOKEN=
ALIGO_CREDENTIAL_SOURCE=server-env
# Required only for server-env; keep blank for request mode.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_ALLOWLIST=
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_MAX_CONCURRENCY=2
