# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 브라우저용 공개 키. 최신 프로젝트는 Publishable key 권장.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# 직원계정 생성/비밀번호 변경/삭제 전용 서버 키.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 말고, Git에 실제 값을 올리지 마세요.
# Supabase Project Settings > API > Service role key 에서 확인합니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Google Sheet(DB가공) -> LawPower 신규 DB webhook 인증키.
# 충분히 긴 랜덤 문자열을 사용하고 Google Apps Script의 LAWPOWER_WEBHOOK_SECRET과 동일하게 맞춥니다.
GOOGLE_SHEETS_WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
GOOGLE_SHEETS_SHEET_NAME=DB가공
