# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Server-only admin key. NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Legacy Maeil Raw2 webhook compatibility (kept during migration).
GOOGLE_SHEETS_WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
GOOGLE_SHEETS_SHEET_NAME=Raw2

# v28.2 multi-firm integration security.
# 32-byte key. Recommended: 64 hex characters. Used to AES-256-GCM encrypt Meta access tokens at rest.
LAWPOWER_INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS

# Meta Graph API version used by the server-side CAPI sender.
# Fill in the version used by your Meta app before enabling automatic rules.
META_GRAPH_API_VERSION=

# Optional external worker secret for /api/integrations/meta/flush.
# Firm/platform admins can also flush the queue manually from the UI.
META_QUEUE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Vercel Cron auth secret. Vercel sends this as Authorization: Bearer <CRON_SECRET>.
# Use a different long random string from META_QUEUE_SECRET.
CRON_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
